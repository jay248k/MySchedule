{
  "name": "mywork-backend",
  "version": "1.0.0",
  "description": "Production Express.js & Sequelize Backend for MySchedule using Neon PostgreSQL",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "migrate": "sequelize-cli db:migrate",
    "migrate:undo": "sequelize-cli db:migrate:undo",
    "migrate:undo:all": "sequelize-cli db:migrate:undo:all",
    "seed": "node seeders/seedRunner.js",
    "seed:clean": "node seeders/seedRunner.js --clean",
    "seed:undo": "node seeders/seedRunner.js --undo",
    "test:db": "node -e \"require('./config/database').testConnection()\""
  },
  "keywords": [
    "express",
    "sequelize",
    "neon",
    "postgresql",
    "calendar",
    "task-manager"
  ],
  "author": "Antigravity",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.0",
    "pg": "^8.11.5",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.3"
  },
  "devDependencies": {
    "nodemon": "^3.1.0",
    "sequelize-cli": "^6.6.2"
  }
}
